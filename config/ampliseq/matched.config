// config/ampliseq/matched.config - nf-core/ampliseq 3.1.0, matched Stage 2 run (D30).
// Module arguments and resource limits only (pipeline parameters are in
// params_matched.yaml; the ampliseq docs reserve -c for resources, infrastructure
// and module arguments). Each override makes one DADA2 call identical to
// q2-dada2 2026.10 as used in Stage 1 (script 08); see
// docs/STAGE2_PARAMETER_MATCH.md. ampliseq publishes the arguments actually
// used to results/ampliseq/dada2/args/*.args.txt: check them after the smoke test.

process {
    resourceLimits = [ cpus: 6, memory: 24.GB, time: 48.h ]

    // Error learning as q2-dada2: learnErrors(filts, nreads = 1e6) with the
    // remaining arguments at their DADA2 defaults (nbases = 1e8,
    // randomize = FALSE, MAX_CONSIST = 10, OMEGA_C = 0, qualityType = "Auto").
    // ampliseq default differs: randomize = TRUE, nreads = NULL.
    withName: 'DADA2_ERR' {
        ext.args = 'nbases = 1e8, nreads = 1e6, randomize = FALSE, MAX_CONSIST = 10, OMEGA_C = 0, qualityType = "Auto", errorEstimationFunction = loessErrfun'
    }

    // Chimera removal as Stage 1: consensus, minFoldParentOverAbundance = 1,
    // allowOneOff = FALSE; other arguments at DADA2 defaults (as in ampliseq).
    // ampliseq default differs: minFoldParentOverAbundance = 2.
    withName: 'DADA2_RMCHIMERA' {
        ext.args = 'method = "consensus", minSampleFraction = 0.9, ignoreNNegatives = 1, minFoldParentOverAbundance = 1, minParentAbundance = 8, allowOneOff = FALSE, minOneOffParentDistance = 4, maxShift = 16'
    }
}
